# Project Sentinel Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
SECRET_KEY=sentinel_secret_key_change_in_production

# AI / LLM Orchestration (Optional for CrewAI agent enhancement)
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# Threat Intelligence APIs (Optional)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Persistence & Queues (Optional - in-memory fallback enabled by default)
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=sentinel_db
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
